<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="ماليتي">
<title>ماليتي</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#F5F6F8;--card:#fff;--tx:#14213D;--mu:#6B7280;--ln:#E7E9EE;--pri:#2F5BEA;--inc:#12945B;--exp:#D9485B;--trf:#7C5CDB;--sh:0 1px 3px rgba(20,33,61,.07);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1A1A1C;--card:#262629;--tx:#F2F2F4;--mu:#A3A3AB;--ln:#38383D;--pri:#5B8CFF;--inc:#3DD598;--exp:#FF7A8A;--trf:#A99BFF;--sh:none}}
:root[data-theme="dark"]{--bg:#1A1A1C;--card:#262629;--tx:#F2F2F4;--mu:#A3A3AB;--ln:#38383D;--pri:#5B8CFF;--inc:#3DD598;--exp:#FF7A8A;--trf:#A99BFF;--sh:none}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100%;background:var(--bg);color:var(--tx);font-family:'IBM Plex Sans Arabic',system-ui,sans-serif;font-size:16px;padding-bottom:calc(100px + env(safe-area-inset-bottom,0px))}
main{max-width:520px;margin:0 auto;padding:16px}
h1{font-size:22px;margin:4px 0 14px;display:flex;justify-content:space-between;align-items:center}
h2{font-size:15px;color:var(--mu);font-weight:500;margin:20px 0 8px}
.card{background:var(--card);border-radius:18px;padding:16px;box-shadow:var(--sh);margin-bottom:12px}
.big{font-size:34px;font-weight:700;letter-spacing:-.5px}
.mu{color:var(--mu);font-size:13px}
.row{display:flex;justify-content:space-between;align-items:center;gap:8px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;text-align:center}
.num{font-weight:600;direction:ltr;unicode-bidi:plaintext}
.inc{color:var(--inc)}.exp{color:var(--exp)}.trf{color:var(--trf)}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:1.5px solid var(--ln);background:var(--card);color:var(--tx);border-radius:999px;padding:10px 14px;font:inherit;font-size:15px;min-height:44px}
.chip.on{border-color:var(--pri);background:var(--pri);color:#fff}
.btn{width:100%;border:0;border-radius:14px;background:var(--pri);color:#fff;font:inherit;font-weight:600;font-size:17px;padding:15px;min-height:52px}
.btn.g{background:transparent;color:var(--exp);border:1.5px solid var(--ln);margin-top:8px}
nav{position:sticky;top:env(safe-area-inset-top,0px);background:var(--card);border-bottom:1px solid var(--ln);display:flex;z-index:5}
nav button{flex:1;border:0;background:none;color:var(--mu);font:inherit;font-size:12px;padding:8px 0;display:flex;flex-direction:column;align-items:center;gap:2px;min-height:54px;border-bottom:3px solid transparent}
nav button span{font-size:20px}nav button.on{color:var(--pri);font-weight:600;border-bottom-color:var(--pri)}
.fab{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(20px + env(safe-area-inset-bottom,0px));z-index:6;border:0;background:var(--pri);color:#fff;font:inherit;font-weight:600;font-size:17px;padding:14px 26px;border-radius:999px;box-shadow:0 6px 18px rgba(47,91,234,.4)}
.ov{position:fixed;inset:0;background:rgba(10,15,30,.5);z-index:10;display:flex;align-items:flex-end}
.sheet{background:var(--bg);width:100%;max-width:520px;margin:0 auto;border-radius:24px 24px 0 0;padding:16px 16px calc(20px + env(safe-area-inset-bottom,0px));max-height:92%;overflow:auto;animation:up .2s}
@keyframes up{from{transform:translateY(40px);opacity:0}}
.seg{display:grid;grid-template-columns:repeat(3,1fr);background:var(--card);border-radius:14px;padding:4px;margin-bottom:12px}
.seg button{border:0;background:none;color:var(--mu);font:inherit;padding:11px 0;border-radius:11px;font-size:15px}
.seg button.on{background:var(--pri);color:#fff;font-weight:600}
input,textarea{font:inherit;color:var(--tx);background:var(--card);border:1.5px solid var(--ln);border-radius:12px;padding:12px;width:100%;font-size:16px}
#amt{font-size:42px;font-weight:700;text-align:center;border:0;background:transparent;direction:ltr;padding:8px}
.lbl{font-size:13px;color:var(--mu);margin:14px 0 6px}
.tx{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--ln);width:100%;background:none;border-inline:0;border-top:0;font:inherit;color:inherit;text-align:start}
.tx:last-child{border-bottom:0}.ic{width:42px;height:42px;border-radius:13px;background:var(--bg);display:grid;place-items:center;font-size:21px;flex:none}
.tx .m{flex:1}
.donut{width:150px;height:150px;border-radius:50%;margin:8px auto;display:grid;place-items:center}
.donut i{width:92px;height:92px;border-radius:50%;background:var(--card);display:grid;place-items:center;font-style:normal;font-weight:700;font-size:14px;direction:ltr}
.bar{height:8px;border-radius:6px;background:var(--ln);margin-top:6px;overflow:hidden}.bar b{display:block;height:100%}
.note{background:var(--card);border-radius:14px;padding:13px;margin-bottom:8px;border-inline-start:4px solid #E8A317;font-size:15px}
.toast{position:fixed;bottom:calc(84px + env(safe-area-inset-bottom,0px));left:16px;right:16px;max-width:488px;margin:auto;background:var(--tx);color:var(--bg);padding:13px 16px;border-radius:14px;z-index:20;display:flex;justify-content:space-between}
.toast button{background:none;border:0;color:inherit;font:inherit;font-weight:700}
.warn{color:var(--exp);font-size:14px;margin-top:10px}
.mn{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.mn button{border:0;background:var(--card);border-radius:12px;width:44px;height:44px;font-size:18px;color:var(--tx)}
.scroll{display:flex;gap:8px;overflow-x:auto;padding-bottom:6px;margin-bottom:8px}.scroll .chip{white-space:nowrap}
</style>
</head>
<body>
<nav id="nav"></nav>
<main id="app"></main>
<div id="layer"></div>
<button class="fab" data-a="add">＋ إضافة حركة</button>
<script>
const K='fin1',$=s=>document.querySelector(s);
let S=null;try{S=JSON.parse(localStorage.getItem(K))}catch(e){}
if(!S)S={acc:[{id:'personal',name:'أموالي',icon:'👤',open:0},{id:'shop',name:'المحل',icon:'🏪',open:0}],
cat:[['علاج','💊'],['بيت','🏠'],['كهرباء','💡'],['مياه','💧'],['غاز','🔥'],['مشتريات','🛒'],['مواصلات','🚗'],['أخرى','📦']].map((c,i)=>({id:'c'+i,name:c[0],icon:c[1],arch:0})),tx:[],last:'personal'};
const save=()=>{try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}};
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const today=()=>{const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')};
const fmt=c=>(c/100).toLocaleString('en-US',{maximumFractionDigits:2})+' ج.م';
const sg=(c,s)=>(s<0?'−':'+')+fmt(Math.abs(c));
const live=()=>S.tx.filter(t=>!t.del);
const A=id=>S.acc.find(a=>a.id===id)||{name:'؟',icon:'❔'};
const C=id=>S.cat.find(c=>c.id===id)||{name:'بدون',icon:'📦'};
const bal=id=>S.acc.find(a=>a.id===id).open+live().reduce((s,t)=>s+(t.to===id&&t.type!=='expense'?t.amt:0)-(t.from===id&&t.type!=='income'?t.amt:0),0);
const inM=(m)=>live().filter(t=>t.date.slice(0,7)===m);
function st(m){const L=inM(m);let inc=0,exp=0,wd=0,ad=0;
L.forEach(t=>{if(t.type==='income')inc+=t.amt;if(t.type==='expense'){exp+=t.amt;if(t.from==='shop')wd+=t.amt}
if(t.type==='transfer'){if(t.from==='shop')wd+=t.amt;if(t.to==='shop')ad+=t.amt}});
return{inc,exp,wd,ad,net:wd-ad,rest:inc-exp}}
const shiftM=(m,d)=>{const[y,mo]=m.split('-').map(Number);const x=new Date(y,mo-1+d,1);return x.getFullYear()+'-'+String(x.getMonth()+1).padStart(2,'0')};
const mName=m=>['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'][+m.slice(5)-1]+' '+m.slice(0,4);
function byCat(m){const o={};inM(m).filter(t=>t.type==='expense').forEach(t=>o[t.cat]=(o[t.cat]||0)+t.amt);return o}
function insights(m){const r=[],s=st(m),p=st(shiftM(m,-1));
if(p.exp>0&&s.exp>p.exp*1.1)r.push(`⚠️ مصروفات هذا الشهر أعلى من الشهر السابق بـ${Math.round((s.exp/p.exp-1)*100)}٪.`);
const cur=byCat(m),prev=[1,2,3].map(i=>byCat(shiftM(m,-i)));
Object.keys(cur).forEach(k=>{const av=prev.reduce((a,b)=>a+(b[k]||0),0)/3;if(av>0&&cur[k]>av*1.25)r.push(`${C(k).icon} ${C(k).name} زاد عن متوسط آخر 3 أشهر (${fmt(Math.round(av))}).`)});
const w=[1,2,3].map(i=>st(shiftM(m,-i)).wd);const aw=w.reduce((a,b)=>a+b,0)/3;
if(aw>0&&s.wd>aw*1.2)r.push(`🏪 سحبت من المحل هذا الشهر أكثر من متوسط السحب السابق (${fmt(Math.round(aw))}).`);
return r}
let TH='light';try{TH=localStorage.getItem('finTheme')||'light'}catch(e){}
function applyTheme(){const r=document.documentElement;if(TH==='auto')r.removeAttribute('data-theme');else r.setAttribute('data-theme',TH)}
applyTheme();
let V='home',FL='all',AM=today().slice(0,7),F=null,ED=null;
const tabs=[['home','🏠','الرئيسية'],['tx','🧾','الحركات'],['acc','👛','الحسابات'],['ana','📊','التحليل']];
function render(){$('#nav').innerHTML=tabs.map(t=>`<button class="${V===t[0]?'on':''}" data-a="tab" data-v="${t[0]}"><span>${t[1]}</span>${t[2]}</button>`).join('');
$('#app').innerHTML=({home,tx,acc,ana,set})[V]();$('.fab').style.display=V==='set'?'none':''}
function home(){const m=today().slice(0,7),s=st(m),p=bal('personal'),sh=bal('shop'),tot=S.acc.reduce((a,x)=>a+bal(x.id),0),ins=insights(m);
return `<h1>ماليتي <span><button class="chip" data-a="theme" data-v="${TH==='dark'?'light':'dark'}">${TH==='dark'?'☀️':'🌙'}</button> <button class="chip" data-a="tab" data-v="set">⚙️</button></span></h1>
<div class="card"><div class="mu">إجمالي السيولة (أموالي + المحل)</div><div class="big num">${fmt(tot)}</div></div>
<div class="grid2"><div class="card"><div class="mu">👤 أموالي</div><div class="num" style="font-size:20px">${fmt(p)}</div></div><div class="card"><div class="mu">🏪 المحل</div><div class="num" style="font-size:20px">${fmt(sh)}</div></div></div>
<h2>📊 ملخص ${mName(m)}</h2><div class="card grid3"><div><div class="mu">الدخل</div><div class="num inc">${sg(s.inc,1)}</div></div><div><div class="mu">المصروفات</div><div class="num exp">${sg(s.exp,-1)}</div></div><div><div class="mu">المتبقي</div><div class="num">${fmt(s.rest)}</div></div></div>
<h2>🏪 حركة المحل</h2><div class="card grid3"><div><div class="mu">سحبت</div><div class="num">${fmt(s.wd)}</div></div><div><div class="mu">أضفت</div><div class="num">${fmt(s.ad)}</div></div><div><div class="mu">صافي السحب</div><div class="num">${fmt(s.net)}</div></div></div>
${ins.slice(0,2).map(i=>`<div class="note">${i}</div>`).join('')}`}
function txRow(t){const tr=t.type==='transfer',ic=tr?'🔄':C(t.cat).icon,nm=tr?`تحويل من ${A(t.from).name}`:t.type==='income'?'دخل':C(t.cat).name,sub=tr?`إلى ${A(t.to).name}`:t.type==='income'?`إلى ${A(t.to).name}`:`من ${A(t.from).name}`;
return `<button class="tx" data-a="edit" data-id="${t.id}"><div class="ic">${t.type==='income'?'💰':ic}</div><div class="m"><div>${nm}</div><div class="mu">${sub}${t.note?' · '+t.note:''}</div></div><div class="num ${t.type==='income'?'inc':tr?'trf':'exp'}">${t.type==='income'?'+':tr?'':'−'}${fmt(t.amt)}</div></button>`}
function tx(){const fs=[['all','الكل'],['expense','المصروفات'],['income','الدخل'],['transfer','التحويلات'],['personal','أموالي'],['shop','المحل']];
let L=live().filter(t=>FL==='all'||t.type===FL||t.from===FL||t.to===FL).sort((a,b)=>b.date.localeCompare(a.date)||b.ts-a.ts);
const y=new Date(Date.now()-864e5),ys=y.getFullYear()+'-'+String(y.getMonth()+1).padStart(2,'0')+'-'+String(y.getDate()).padStart(2,'0');let last='',h='';
L.forEach(t=>{if(t.date!==last){last=t.date;h+=`<h2>${t.date===today()?'اليوم':t.date===ys?'أمس':t.date}</h2>`}h+=txRow(t)});
return `<h1>الحركات</h1><div class="scroll">${fs.map(f=>`<button class="chip ${FL===f[0]?'on':''}" data-a="fl" data-v="${f[0]}">${f[1]}</button>`).join('')}</div>${L.length?`<div class="card">${h.replace(/<h2>(.*?)<\/h2>/g,'<div class="mu" style="padding-top:10px">$1</div>')}</div>`:'<div class="card mu">لا توجد حركات بعد. اضغط ＋ لتسجيل أول حركة.</div>'}`}
function acc(){const m=today().slice(0,7);return `<h1>الحسابات</h1>`+S.acc.map(a=>{const L=live();const q=f=>L.filter(f).reduce((s,t)=>s+t.amt,0);
const i=q(t=>t.type==='income'&&t.to===a.id),e=q(t=>t.type==='expense'&&t.from===a.id),ti=q(t=>t.type==='transfer'&&t.to===a.id),to=q(t=>t.type==='transfer'&&t.from===a.id);
const wd=a.id==='shop'?e+to:0;
return `<div class="card"><div class="row"><b>${a.icon} ${a.name}</b></div><div class="mu">الرصيد الحالي</div><div class="big num">${fmt(bal(a.id))}</div>
<div class="grid2" style="margin-top:10px"><div><div class="mu">الدخل</div><div class="num inc">${fmt(i)}</div></div><div><div class="mu">المصروف</div><div class="num exp">${fmt(e)}</div></div><div><div class="mu">تحويلات داخلة</div><div class="num">${fmt(ti)}</div></div><div><div class="mu">تحويلات خارجة</div><div class="num">${fmt(to)}</div></div></div>
${a.id==='shop'?`<hr style="border:0;border-top:1px solid var(--ln)"><div class="grid3"><div><div class="mu">أضفت للمحل</div><div class="num">${fmt(ti)}</div></div><div><div class="mu">سحبت</div><div class="num">${fmt(wd)}</div></div><div><div class="mu">صافي الحركة</div><div class="num">${fmt(wd-ti)}</div></div></div>`:''}</div>`}).join('')}
function ana(){const m=AM,s=st(m),p=st(shiftM(m,-1)),c=byCat(m),ks=Object.keys(c).sort((a,b)=>c[b]-c[a]),P=['#2F5BEA','#12945B','#E8A317','#D9485B','#7C5CDB','#0EA5A5','#F97316','#8B95A7'];
let acc=0;const seg=ks.map((k,i)=>{const a=acc/s.exp*100;acc+=c[k];return `${P[i%8]} ${a}% ${acc/s.exp*100}%`}).join(',');
const ins=insights(m),d=s.exp-p.exp;
return `<h1>التحليل</h1><div class="mn"><button data-a="am" data-v="1">›</button><b>${mName(m)}</b><button data-a="am" data-v="-1">‹</button></div>
<div class="card"><div class="mu">إجمالي المصروفات</div><div class="big num">${fmt(s.exp)}</div>
${ks.length?`<div class="donut" style="background:conic-gradient(${seg})"><i>${ks.length} أنواع</i></div>`+ks.map((k,i)=>`<div style="margin-top:12px"><div class="row"><span>${C(k).icon} ${C(k).name}</span><span class="num">${fmt(c[k])} <span class="mu">${Math.round(c[k]/s.exp*100)}٪</span></span></div><div class="bar"><b style="width:${c[k]/s.exp*100}%;background:${P[i%8]}"></b></div></div>`).join(''):'<div class="mu">لا مصروفات في هذا الشهر.</div>'}</div>
<h2>مقارنة بالشهر السابق</h2><div class="card grid3"><div><div class="mu">هذا الشهر</div><div class="num">${fmt(s.exp)}</div></div><div><div class="mu">السابق</div><div class="num">${fmt(p.exp)}</div></div><div><div class="mu">الفرق</div><div class="num ${d>0?'exp':'inc'}">${sg(d,d)}</div></div></div>
${ins.length?'<h2>ملاحظات</h2>'+ins.map(i=>`<div class="note">${i}</div>`).join(''):''}`}
function set(){return `<h1>الإعدادات <button class="chip" data-a="tab" data-v="home">رجوع</button></h1>
<h2>المظهر</h2><div class="card"><div class="chips">${[['light','☀️ فاتح'],['dark','🌙 داكن'],['auto','📱 تلقائي']].map(x=>`<button class="chip ${TH===x[0]?'on':''}" data-a="theme" data-v="${x[0]}">${x[1]}</button>`).join('')}</div></div>
<h2>الأرصدة الافتتاحية</h2><div class="card">${S.acc.map(a=>`<div class="lbl">${a.icon} ${a.name}</div><input inputmode="decimal" data-open="${a.id}" value="${a.open/100}">`).join('')}<button class="btn" style="margin-top:12px" data-a="saveopen">حفظ الأرصدة</button></div>
<h2>إضافة حساب (بنك / محفظة)</h2><div class="card"><input id="na" placeholder="اسم الحساب"><button class="btn" style="margin-top:10px" data-a="addacc">إضافة حساب</button></div>
<h2>التصنيفات</h2><div class="card">${S.cat.filter(c=>!c.arch).map(c=>`<div class="row" style="padding:6px 0"><span>${c.icon} ${c.name}</span><span><button class="chip" data-a="rencat" data-id="${c.id}">تعديل</button> <button class="chip" data-a="delcat" data-id="${c.id}">أرشفة</button></span></div>`).join('')}</div>
<h2>نسخة احتياطية</h2><div class="card"><div class="mu">انسخ النص وخزّنه في ملاحظاتك. للاستعادة ألصقه هنا.</div><textarea id="bk" rows="4">${JSON.stringify(S).replace(/</g,'&lt;')}</textarea><button class="btn" style="margin-top:10px" data-a="restore">استعادة من النص</button></div>`}
function openAdd(t){ED=t?t.id:null;F=t?{type:t.type,amt:String(t.amt/100),cat:t.cat,from:t.from,to:t.to,note:t.note||'',date:t.date}:{type:'expense',amt:'',cat:null,from:S.last||'personal',to:'personal',note:'',date:today()};F.warn=0;sheet()}
function sheet(){const ty=F.type,cats=S.cat.filter(c=>!c.arch),ac=(k)=>S.acc.map(a=>`<button class="chip ${F[k]===a.id?'on':''}" data-a="pk" data-k="${k}" data-v="${a.id}">${a.icon} ${a.name}</button>`).join('');
$('#layer').innerHTML=`<div class="ov" data-a="close"><div class="sheet" onclick="event.stopPropagation()">
<div class="seg">${[['expense','💸 مصروف'],['income','💰 دخل'],['transfer','🔄 تحويل']].map(x=>`<button class="${ty===x[0]?'on':''}" data-a="ty" data-v="${x[0]}">${x[1]}</button>`).join('')}</div>
<input id="amt" inputmode="decimal" placeholder="0" value="${F.amt}"><div class="mu" style="text-align:center">ج.م</div>
${ty==='expense'?`<div class="lbl">صرفته في</div><div class="chips">${cats.map(c=>`<button class="chip ${F.cat===c.id?'on':''}" data-a="pk" data-k="cat" data-v="${c.id}">${c.icon} ${c.name}</button>`).join('')}<button class="chip" data-a="newcat">＋ نوع جديد</button></div>`:''}
${F.nc?`<div class="row" style="margin-top:10px"><input id="ci" style="width:70px;text-align:center" value="🏷️"><input id="cn" placeholder="اسم النوع"><button class="chip on" data-a="savecat">حفظ</button></div>`:''}
${ty==='expense'?`<div class="lbl">أخذت الفلوس منين؟</div><div class="chips">${ac('from')}</div>`:''}
${ty==='income'?`<div class="lbl">دخلت في</div><div class="chips">${ac('to')}</div>`:''}
${ty==='transfer'?`<div class="lbl">من</div><div class="chips">${ac('from')}</div><div class="lbl">إلى</div><div class="chips">${ac('to')}</div><button class="chip" style="margin-top:8px" data-a="swap">⇄ تبديل</button>`:''}
<div class="lbl">ملاحظة (اختياري)</div><input id="nt" value="${(F.note||'').replace(/"/g,'&quot;')}" placeholder="مثلاً: دكتور أسنان">
<div class="lbl">التاريخ</div><input id="dt" type="date" value="${F.date}">
${F.err?`<div class="warn">${F.err}</div>`:''}
<button class="btn" style="margin-top:14px" data-a="submit">${F.warn?'تسجيل رغم الرصيد السالب':ED?'حفظ التعديل':ty==='expense'?'تسجيل المصروف':ty==='income'?'تسجيل الدخل':'تسجيل التحويل'}</button>
${ED?`<button class="btn g" data-a="del">حذف الحركة</button>`:''}</div></div>`;
if(!F.nc&&!ED&&!F.amt)setTimeout(()=>{const a=$('#amt');a&&a.focus()},50)}
function grab(){const a=$('#amt');if(!a)return;F.amt=a.value;F.note=$('#nt').value;F.date=$('#dt').value;const c=$('#cn');if(c)F.cn=c.value}
function toast(m,undo){const t=document.createElement('div');t.className='toast';t.innerHTML=`<span>${m}</span>${undo?'<button>تراجع</button>':''}`;document.body.appendChild(t);if(undo)t.querySelector('button').onclick=()=>{undo();t.remove()};setTimeout(()=>t.remove(),4500)}
function submit(){grab();const amt=Math.round(parseFloat((F.amt||'').replace(/[٠-٩]/g,d=>'٠١٢٣٤٥٦٧٨٩'.indexOf(d)).replace(/,/g,'.'))*100);
F.err='';if(!(amt>0))F.err='اكتب مبلغًا أكبر من صفر.';
else if(F.type==='expense'&&!F.cat)F.err='اختر نوع المصروف.';
else if(F.type==='transfer'&&F.from===F.to)F.err='اختر حسابين مختلفين للتحويل.';
if(F.err)return sheet();
if(!F.warn){const other=ED?S.tx.find(t=>t.id===ED):null;let b={};S.acc.forEach(a=>b[a.id]=bal(a.id)+(other&&!other.del?(other.type!=='expense'&&other.to===a.id?-other.amt:0)+(other.type!=='income'&&other.from===a.id?other.amt:0):0));
const f=F.type!=='income'?F.from:null;if(f&&b[f]-amt<0){F.warn=1;F.err='هذه الحركة ستجعل رصيد '+A(f).name+' سالبًا.';return sheet()}}
const o={type:F.type,amt,date:F.date||today(),from:F.type==='income'?null:F.from,to:F.type==='expense'?null:F.to,cat:F.type==='expense'?F.cat:null,note:F.note.trim()};
if(ED){Object.assign(S.tx.find(t=>t.id===ED),o)}else S.tx.push({id:uid(),ts:Date.now(),...o});
if(F.type==='expense')S.last=F.from;save();$('#layer').innerHTML='';F=null;toast('تم التسجيل ✓');render()}
const act={
theme:e=>{TH=e.dataset.v;try{localStorage.setItem('finTheme',TH)}catch(x){}applyTheme();render()},
tab:e=>{V=e.dataset.v;window.scrollTo(0,0);render()},
add:()=>openAdd(),close:()=>{$('#layer').innerHTML='';F=null},
edit:e=>openAdd(S.tx.find(t=>t.id===e.dataset.id)),
fl:e=>{FL=e.dataset.v;render()},am:e=>{AM=shiftM(AM,+e.dataset.v);render()},
ty:e=>{grab();F.type=e.dataset.v;F.err='';F.warn=0;if(F.type==='transfer'&&F.from===F.to)F.to=S.acc.find(a=>a.id!==F.from).id;sheet()},
pk:e=>{grab();F[e.dataset.k]=e.dataset.v;F.err='';F.warn=0;sheet()},
swap:()=>{grab();[F.from,F.to]=[F.to,F.from];sheet()},
newcat:()=>{grab();F.nc=1;sheet()},
savecat:()=>{grab();const n=(F.cn||'').trim(),ic=$('#ci').value||'🏷️';if(!n)return;if(S.cat.some(c=>!c.arch&&c.name===n)){F.err='هذا النوع موجود بالفعل.';return sheet()}const c={id:'c'+uid(),name:n,icon:ic,arch:0};S.cat.push(c);F.cat=c.id;F.nc=0;F.cn='';F.err='';save();sheet()},
submit,
del:()=>{const id=ED;S.tx.find(t=>t.id===id).del=1;save();act.close();render();toast('تم حذف الحركة',()=>{S.tx.find(t=>t.id===id).del=0;save();render()})},
saveopen:()=>{document.querySelectorAll('[data-open]').forEach(i=>{const v=Math.round(parseFloat(i.value||'0')*100)||0;S.acc.find(a=>a.id===i.dataset.open).open=v});save();toast('تم حفظ الأرصدة ✓')},
addacc:()=>{const n=$('#na').value.trim();if(!n)return;S.acc.push({id:'a'+uid(),name:n,icon:'🏦',open:0});save();render()},
rencat:e=>{const c=C(e.dataset.id),n=window.prompt('الاسم الجديد',c.name);if(n&&n.trim()){c.name=n.trim();save();render()}},
delcat:e=>{C(e.dataset.id).arch=1;save();render();toast('تمت الأرشفة، والحركات القديمة كما هي')},
restore:()=>{try{const d=JSON.parse($('#bk').value);if(!d.acc||!d.tx||!d.cat)throw 0;S=d;save();toast('تمت الاستعادة ✓');render()}catch(x){toast('النص غير صالح')}}
};
document.addEventListener('click',e=>{const el=e.target.closest('[data-a]');if(!el)return;if(el.classList.contains('ov')&&e.target!==el)return;act[el.dataset.a]&&act[el.dataset.a](el)});
render();
</script>
</body>
</html>
